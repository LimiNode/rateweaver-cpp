cmake_minimum_required(VERSION 3.21)
set(platform_args)
if(GENERATOR_PLATFORM)
    list(APPEND platform_args -A "${GENERATOR_PLATFORM}")
endif()
foreach(probe host legacy-normal system-missing unsupported-prebuilt)
    set(work_dir "${BUILD_DIR}/curl-resolution/${probe}")
    execute_process(COMMAND "${CMAKE_COMMAND}"
        -S "${CMAKE_CURRENT_LIST_DIR}/curl_resolution" -B "${work_dir}"
        -G "${GENERATOR}" ${platform_args} "-DCMAKE_CXX_COMPILER=${CXX_COMPILER}"
        "-DRATEWEAVER_SOURCE_DIR=${SOURCE_DIR}" "-DPROBE=${probe}"
        RESULT_VARIABLE result OUTPUT_VARIABLE output ERROR_VARIABLE error)
    if(probe STREQUAL "host" OR probe STREQUAL "legacy-normal")
        if(NOT result EQUAL 0)
            message(FATAL_ERROR "Resolver probe ${probe} failed: ${output}\n${error}")
        endif()
    else()
        if(result EQUAL 0)
            message(FATAL_ERROR "Resolver accepted ${probe}")
        endif()
        if(probe STREQUAL "system-missing" AND NOT "${output}${error}" MATCHES "SYSTEM")
            message(FATAL_ERROR "Missing SYSTEM curl diagnostic: ${output}\n${error}")
        elseif(probe STREQUAL "unsupported-prebuilt" AND NOT "${output}${error}" MATCHES "PREBUILT.*MinGW")
            message(FATAL_ERROR "Missing unsupported PREBUILT diagnostic: ${output}\n${error}")
        endif()
        if(EXISTS "${work_dir}/_deps")
            message(FATAL_ERROR "Rejected mode attempted dependency acquisition: ${probe}")
        endif()
    endif()
endforeach()
