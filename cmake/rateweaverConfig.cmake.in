@PACKAGE_INIT@

include(CMakeFindDependencyMacro)
find_dependency(Threads)
include("${CMAKE_CURRENT_LIST_DIR}/rateweaverTargets.cmake")

# Optional components are resolved only when requested. A core-only installed
# consumer never searches for JSON, XML or HTTP dependencies.
foreach(component IN LISTS rateweaver_FIND_COMPONENTS)
    set(rateweaver_${component}_FOUND FALSE)
    if(component STREQUAL "providers" AND @RATEWEAVER_BUILD_PROVIDERS@)
        if(NOT TARGET nlohmann_json::nlohmann_json)
            if(rateweaver_FIND_REQUIRED_providers)
                find_dependency(nlohmann_json 3.11 CONFIG)
            else()
                find_package(nlohmann_json 3.11 QUIET CONFIG)
            endif()
        endif()
        if(TARGET nlohmann_json::nlohmann_json)
            include("${CMAKE_CURRENT_LIST_DIR}/rateweaverProviderTargets.cmake")
            set(rateweaver_providers_FOUND TRUE)
        endif()
    elseif(component STREQUAL "ecb" AND @RATEWEAVER_ENABLE_ECB@)
        if(NOT TARGET pugixml::pugixml)
            if(rateweaver_FIND_REQUIRED_ecb)
                find_dependency(pugixml 1.13 CONFIG)
            else()
                find_package(pugixml 1.13 QUIET CONFIG)
            endif()
        endif()
        if(TARGET pugixml::pugixml)
            include("${CMAKE_CURRENT_LIST_DIR}/rateweaverEcbTargets.cmake")
            set(rateweaver_ecb_FOUND TRUE)
        endif()
    elseif(component STREQUAL "kurlyk" AND @RATEWEAVER_ENABLE_KURLYK@)
        include("${CMAKE_CURRENT_LIST_DIR}/rateweaverKurlykDependency.cmake")
        rateweaver_resolve_kurlyk("${rateweaver_FIND_REQUIRED_kurlyk}")
        if(TARGET rateweaver_deps::kurlyk)
            include("${CMAKE_CURRENT_LIST_DIR}/rateweaverKurlykTargets.cmake")
            set(rateweaver_kurlyk_FOUND TRUE)
        endif()
    endif()
endforeach()
check_required_components(rateweaver)
