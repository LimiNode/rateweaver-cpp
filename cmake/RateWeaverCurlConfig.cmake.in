@PACKAGE_INIT@
if(TARGET CURL::libcurl)
    return()
endif()
if(NOT WIN32 OR NOT MINGW OR NOT CMAKE_SIZEOF_VOID_P EQUAL 8 OR
   NOT CMAKE_SYSTEM_PROCESSOR MATCHES "^(AMD64|amd64|x86_64|x64)$")
    set(CURL_FOUND FALSE)
    set(CURL_NOT_FOUND_MESSAGE "This prebuilt CURL package requires Windows MinGW x64; provide a compatible CURL::libcurl target or another CURL package")
    return()
endif()
set_and_check(CURL_INCLUDE_DIR "@PACKAGE_CMAKE_INSTALL_INCLUDEDIR@")
set_and_check(_rateweaver_curl_implib "@PACKAGE_CMAKE_INSTALL_LIBDIR@/libcurl.dll.a")
set_and_check(_rateweaver_curl_dll "@PACKAGE_CMAKE_INSTALL_BINDIR@/libcurl-x64.dll")
add_library(CURL::libcurl SHARED IMPORTED)
set_target_properties(CURL::libcurl PROPERTIES
    IMPORTED_IMPLIB "${_rateweaver_curl_implib}"
    IMPORTED_LOCATION "${_rateweaver_curl_dll}"
    INTERFACE_INCLUDE_DIRECTORIES "${CURL_INCLUDE_DIR}")
set(CURL_VERSION 8.22.0)
set(CURL_VERSION_STRING 8.22.0)
set(CURL_INCLUDE_DIRS "${CURL_INCLUDE_DIR}")
set(CURL_LIBRARIES CURL::libcurl)
unset(_rateweaver_curl_implib)
unset(_rateweaver_curl_dll)
check_required_components(CURL)
