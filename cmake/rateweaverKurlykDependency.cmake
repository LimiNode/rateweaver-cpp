# Host targets retain their feature definitions and lifecycle ownership.
# The HTTP-only package is separately named, not a replacement upstream target.
function(rateweaver_resolve_kurlyk required mode)
    if(TARGET rateweaver_deps::kurlyk)
        return()
    endif()
    set(dependency "")
    if(TARGET kurlyk::kurlyk)
        set(dependency kurlyk::kurlyk)
    elseif(TARGET kurlyk)
        set(dependency kurlyk)
    else()
        if(NOT TARGET RateWeaverKurlykHttp::client)
            if(mode STREQUAL "BUNDLED")
                rateweaver_add_bundled_http()
            else()
                find_package(RateWeaverKurlykHttp 1.1.1 QUIET CONFIG)
                if(NOT TARGET RateWeaverKurlykHttp::client)
                    find_package(kurlyk 1.1.1 QUIET CONFIG)
                endif()
            endif()
        endif()
        if(TARGET RateWeaverKurlykHttp::client)
            set(dependency RateWeaverKurlykHttp::client)
        elseif(TARGET kurlyk::kurlyk)
            set(dependency kurlyk::kurlyk)
        endif()
    endif()
    if(NOT dependency)
        if(required)
            message(FATAL_ERROR "Provide kurlyk::kurlyk, or install the kurlyk/RateWeaverKurlykHttp dependency package")
        endif()
        return()
    endif()
    add_library(rateweaver_deps::kurlyk INTERFACE IMPORTED GLOBAL)
    set_target_properties(rateweaver_deps::kurlyk PROPERTIES INTERFACE_LINK_LIBRARIES "${dependency}")
endfunction()
